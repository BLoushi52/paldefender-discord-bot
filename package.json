{
  "name": "paldefender-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord slash-command bridge for the PalDefender Palworld REST API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLoushi52/paldefender-discord-bot.git"
  },
  "bugs": {
    "url": "https://github.com/BLoushi52/paldefender-discord-bot/issues"
  },
  "homepage": "https://github.com/BLoushi52/paldefender-discord-bot#readme",
  "keywords": [
    "discord",
    "discord-bot",
    "palworld",
    "paldefender",
    "slash-commands"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "doctor": "node src/doctor.js",
    "check": "node --check src/index.js && node --check src/commands.js && node --check src/api.js && node --check src/config.js && node --check src/limits.js && node --check src/response.js && node --check src/authorization.js && node --check src/deploy-commands.js && node --check src/doctor.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75",
    "validate": "npm run check && npm run test:coverage"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2"
  },
  "files": [
    "src/",
    "deploy/",
    "docs/",
    "examples/",
    ".env.example",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md"
  ]
}
