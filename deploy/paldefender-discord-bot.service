[Unit]
Description=PalDefender Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=palbot
Group=palbot
WorkingDirectory=/opt/paldefender-discord-bot
ExecStart=/usr/bin/node /opt/paldefender-discord-bot/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
