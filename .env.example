# Copy this file to .env. Never commit the resulting .env file.
# Discord Developer Portal values
DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id
# Required: every self-hosted installation controls exactly one Discord server.
DISCORD_GUILD_ID=replace_with_your_discord_server_id

# Optional branding shown in command replies and the bot's Discord activity.
# The actual bot username/avatar are configured in the Discord Developer Portal.
BOT_BRAND_NAME=Palworld Admin
BOT_ACTIVITY_TEXT=Managing Palworld
BOT_COPYRIGHT_TEXT=
BOT_SUPPORT_URL=

# Same-host PalDefender defaults. Keep this on loopback.
PALDEFENDER_BASE_URL=http://127.0.0.1:17993
PALDEFENDER_TOKEN=replace_with_your_dedicated_paldefender_token
PALDEFENDER_TIMEOUT_MS=7000
# Maximum accepted API response and Discord attachment size (1 KiB to 7 MiB).
PALDEFENDER_MAX_RESPONSE_BYTES=7340032

# Optional comma-separated Discord IDs. Administrators are always allowed.
# If both lists are blank, only members with Discord Administrator are allowed.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=

# Only set true if PalDefender is intentionally on another trusted host.
# Remote URLs must use HTTPS unless the separate insecure override is also true.
PALDEFENDER_ALLOW_REMOTE=false
# Dangerous: permits a bearer token over plain HTTP to a non-loopback host.
PALDEFENDER_ALLOW_INSECURE_REMOTE=false
